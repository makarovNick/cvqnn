# environment and data - never in the repository
.venv/
_data/
data/
__pycache__/
*.pyc

# run artefacts
cvqnn_out/
viz_out/
*.pt
*.png

# ...except results we deliberately keep in history, including the checkpoint
# the visualization notebook loads (~12 MB, one per recorded experiment)
!results/**/*.png
!results/**/*.pt

# generated by kaggle/push_kernel.ps1 from the main file; keeping a second
# copy in git guarantees it eventually drifts from the original
kaggle/cvqnn_cifar10.py

# downloads from Kaggle: run logs and fetched datasets
kaggle/out/
kaggle/pulled*/

# misc
.ipynb_checkpoints/
